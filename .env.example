# 阿里云 DashScope API Key
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_api_key_here

# ===== 云控智行API凭据 =====

# HTTP轮询账号（用于 /v2x/platform/device/road/info 接口）
TSINGCLOUD_APP_KEY=your_http_username
TSINGCLOUD_PASSWORD=your_http_password

# RTSP账号（用于 /monitorModel/singleCameraQuery2 接口）
TSINGCLOUD_RTSP_APP_KEY=your_rtsp_username
TSINGCLOUD_RTSP_PASSWORD=your_rtsp_password

# 设备映射文件路径（可选，默认使用项目相对路径）
# TSINGCLOUD_DEVICE_MAPPING_FILE=/path/to/deviceDJKK.csv
